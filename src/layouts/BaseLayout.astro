---
import "../assets/css/main.css";
import Header from "../components/layout/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sadhan — Technology, problem solving, and things worth figuring out",
  description = "A personal space for technology, problem solving, learning, and writing.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <slot />
</body>

</html>